              <description>CLB S1[15:0] bit: FSM next state function for S1 and unitx</description>
              <msb>31</msb>
              <lsb>16</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>S0</name>
              <description>CLB S0[15:0] bit: FSM next state function for S0 and unitx</description>
              <msb>15</msb>
              <lsb>0</lsb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MISCCONTROL</name>
