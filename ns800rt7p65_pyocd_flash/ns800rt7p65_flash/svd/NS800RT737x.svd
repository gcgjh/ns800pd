              <msb>16</msb>
              <lsb>16</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>FREESOFT</name>
              <description>EPWM FREESOFT[1:0] bit: emulation mode bits</description>
              <msb>15</msb>
              <lsb>14</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>PHSDIR</name>
