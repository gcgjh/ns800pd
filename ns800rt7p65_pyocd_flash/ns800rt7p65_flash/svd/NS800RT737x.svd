              <msb>12</msb>
              <lsb>10</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>HSPCLKDIV</name>
              <description>EPWM HSPCLKDIV[2:0] bit: high speed time base clock prescale bits</description>
              <msb>9</msb>
              <lsb>7</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>SWFSYNC</name>
              <description>EPWM SWFSYNC bit: software forced sync pulse</description>
