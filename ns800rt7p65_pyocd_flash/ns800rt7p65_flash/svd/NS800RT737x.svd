            </field>
            <field>
              <name>COUNT0MATCH2TAPEN</name>
              <description>CLB COUNT0MATCH2TAPEN bit: if the match2 output should come from the match unit or tapped from a bit position of the counter 0</description>
              <msb>21</msb>
              <lsb>21</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNT2MATCH1TAPEN</name>
              <description>CLB COUNT2MATCH1TAPEN bit: if the match1 output should come from the match unit or tapped from a bit position of the counter 2</description>
              <msb>20</msb>
              <lsb>20</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNT1MATCH1TAPEN</name>
              <description>CLB COUNT1MATCH1TAPEN bit: if the match1 output should come from the match unit or tapped from a bit position of the counter 1</description>
              <msb>19</msb>
              <lsb>19</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNT0MATCH1TAPEN</name>
              <description>CLB COUNT0MATCH1TAPEN bit: if the match1 output should come from the match unit or tapped from a bit position of the counter 0</description>
              <msb>18</msb>
              <lsb>18</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>FSMEXTRASEL12</name>
              <description>CLB FSMEXTRASEL12 bit: which input should be selected for the FSM LUT of UNIT 2 1</description>
              <msb>17</msb>
              <lsb>17</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>FSMEXTRASEL02</name>
              <description>CLB FSMEXTRASEL02 bit: which input should be selected for the FSM LUT of UNIT 2 0</description>
              <msb>16</msb>
              <lsb>16</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>FSMEXTRASEL11</name>
              <description>CLB FSMEXTRASEL11 bit: which input should be selected for the FSM LUT of UNIT 1 1</description>
              <msb>15</msb>
              <lsb>15</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>FSMEXTRASEL01</name>
              <description>CLB FSMEXTRASEL01 bit: which input should be selected for the FSM LUT of UNIT 1 0</description>
              <msb>14</msb>
              <lsb>14</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>FSMEXTRASEL10</name>
              <description>CLB FSMEXTRASEL10 bit: which input should be selected for the FSM LUT of UNIT 0 1 </description>
              <msb>13</msb>
              <lsb>13</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>FSMEXTRASEL00</name>
              <description>CLB FSMEXTRASEL00 bit: which input should be selected for the FSM LUT of UNIT 0 0 </description>
              <msb>12</msb>
              <lsb>12</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTSERIALIZER2</name>
              <description>CLB COUNTSERIALIZER2 bit: controls if the counter of UNIT 2 is the serialzer mode or not</description>
              <msb>11</msb>
              <lsb>11</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTSERIALIZER1</name>
              <description>CLB COUNTSERIALIZER1 bit: controls if the counter of UNIT 1 is the serialzer mode or not</description>
              <msb>10</msb>
              <lsb>10</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTSERIALIZER0</name>
              <description>CLB COUNTSERIALIZER0 bit: controls if the counter of UNIT 0 is the serialzer mode or not</description>
              <msb>9</msb>
              <lsb>9</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTEVENTCTRL2</name>
              <description>CLB COUNTEVENTCTRL2 bit: controls the actions on an EVENT for UNIT2</description>
              <msb>8</msb>
              <lsb>8</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTDIR2</name>
              <description>CLB COUNTDIR2 bit: controls add/shift direction for UNIT 2 </description>
              <msb>7</msb>
              <lsb>7</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTADDSHIFT2</name>
              <description>CLB COUNTADDSHIFT2 bit: controls whether the UNIT 2 counter will do an ADD or a SHIFT on an EVENT</description>
              <msb>6</msb>
              <lsb>6</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTEVENTCTRL1</name>
              <description>CLB COUNTEVENTCTRL1 bit: controls the actions on an EVENT for UNIT1</description>
              <msb>5</msb>
              <lsb>5</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTDIR1</name>
              <description>CLB COUNTDIR1 bit: controls add/shift direction for UNIT 1</description>
              <msb>4</msb>
              <lsb>4</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTADDSHIFT1</name>
              <description>CLB COUNTADDSHIFT1 bit: controls whether the UNIT 1 counter will do an ADD or a SHIFT on an EVENT</description>
              <msb>3</msb>
              <lsb>3</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTEVENTCTRL0</name>
              <description>CLB COUNTEVENTCTRL0 bit: controls the actions on an EVENT for UNIT0</description>
              <msb>2</msb>
              <lsb>2</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTDIR0</name>
              <description>CLB COUNTDIR0 bit: controls add/shift direction for UNIT 0</description>
              <msb>1</msb>
              <lsb>1</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNTADDSHIFT0</name>
              <description>CLB COUNTADDSHIFT0 bit: controls whether the UNIT 0 counter will do an ADD or a SHIFT on an EVENT</description>
              <msb>0</msb>
              <lsb>0</lsb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <name>OUTPUTLUTX[%s]</name>
          <description>Grouping of OUTPUTLUT0~OUTPUTLUT7</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>FN</name>
              <description>CLB FN[7:0] bit: output function for output LUTx</description>
              <msb>22</msb>
              <lsb>15</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>IN2</name>
              <description>CLB IN2[4:0] bit: select value for IN2 of output LUTx</description>
              <msb>14</msb>
              <lsb>10</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>IN1</name>
              <description>CLB IN1[4:0] bit: select value for IN1 of output LUTx</description>
              <msb>9</msb>
              <lsb>5</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>IN0</name>
              <description>CLB IN0[4:0] bit: select value for IN0 of output LUTx</description>
              <msb>4</msb>
              <lsb>0</lsb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>HLCEVENTSEL</name>
          <description>CLB defines selection of alternate inputs for EVENT0~3 high level controller</description>
          <addressOffset>0x00000070</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ALTEVENT3SEL</name>
              <description>CLB ALTEVENT3SEL bit: defines selection of alternate inputs for EVENT3</description>
              <msb>23</msb>
              <lsb>23</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>ALTEVENT2SEL</name>
              <description>CLB ALTEVENT2SEL bit: defines selection of alternate inputs for EVENT2</description>
              <msb>22</msb>
              <lsb>22</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>ALTEVENT1SEL</name>
              <description>CLB ALTEVENT1SEL bit: defines selection of alternate inputs for EVENT1</description>
              <msb>21</msb>
              <lsb>21</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>ALTEVENT0SEL</name>
              <description>CLB ALTEVENT0SEL bit: defines selection of alternate inputs for EVENT0</description>
              <msb>20</msb>
              <lsb>20</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>EVENT3SEL</name>
              <description>CLB EVENT3SEL[4:0] bit: 5 bit select value for EVENT3 of the high level controller</description>
              <msb>19</msb>
              <lsb>15</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>EVENT2SEL</name>
              <description>CLB EVENT2SEL[4:0] bit: 5 bit select value for EVENT2 of the high level controller</description>
              <msb>14</msb>
              <lsb>10</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>EVENT1SEL</name>
              <description>CLB EVENT1SEL[4:0] bit: 5 bit select value for EVENT1 of the high level controller</description>
              <msb>9</msb>
              <lsb>5</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>EVENT0SEL</name>
              <description>CLB EVENT0SEL[4:0] bit: 5 bit select value for EVENT0 of the high level controller</description>
              <msb>4</msb>
              <lsb>0</lsb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COUNT01MATCHTAPSEL</name>
          <description>CLB MUX select for match tap for counter unit 0~2</description>
          <addressOffset>0x00000074</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>COUNT2MATCH2</name>
              <description>CLB COUNT2MATCH2[4:0] bit: 5 bit MUX select for match1 tap for counter unit 2</description>
              <msb>30</msb>
              <lsb>26</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNT1MATCH2</name>
              <description>CLB COUNT1MATCH2[4:0] bit: 5 bit MUX select for match1 tap for counter unit 1</description>
              <msb>25</msb>
              <lsb>21</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNT0MATCH2</name>
              <description>CLB COUNT0MATCH2[4:0] bit: 5 bit MUX select for match1 tap for counter unit 0</description>
              <msb>20</msb>
              <lsb>16</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNT2MATCH1</name>
              <description>CLB COUNT2MATCH1[4:0] bit: 5 bit MUX select for match0 tap for counter unit 2</description>
              <msb>14</msb>
              <lsb>10</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNT1MATCH1</name>
              <description>CLB COUNT1MATCH1[4:0] bit: 5 bit MUX select for match0 tap for counter unit 1</description>
              <msb>9</msb>
              <lsb>5</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNT0MATCH1</name>
              <description>CLB COUNT0MATCH1[4:0] bit: 5 bit MUX select for match0 tap for counter unit 0</description>
              <msb>4</msb>
              <lsb>0</lsb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <name>OUTPUTCONDCTRLX[%s]</name>
          <description>Grouping of OUTPUTLUTCONDCTRL0~OUTPUTLUTCONDCTRL7</description>
          <addressOffset>0x78</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ASYNCCONDEN</name>
              <description>CLB ASYNCCONDEN bit: controls whether the output will pass through the asynchronous conditioning block or bypass it</description>
              <msb>14</msb>
              <lsb>14</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>SELRAWIN</name>
              <description>CLB SELRAWIN bit: controls whether the CELL outputs or inputs are sent to the output conditioning block logic</description>
              <msb>13</msb>
              <lsb>13</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>HWRLSCTRLSEL</name>
              <description>CLB HWRLSCTRLSEL bit: controls whether the HW or software will act as the release control</description>
              <msb>12</msb>
              <lsb>12</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>HWGATINGCTRLSEL</name>
              <description>CLB HWGATINGCTRLSEL bit: controls whether the HW or software will act as the gating control</description>
              <msb>11</msb>
              <lsb>11</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>SELRELEASESEL</name>
              <description>CLB SELRELEASESEL[2:0] bit: 3 bit MUX selects which will select one of the 8 CELL outputs for release control</description>
              <msb>10</msb>
              <lsb>8</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>SELGATINGCTRL</name>
              <description>CLB SELGATINGCTRL[2:0] bit: 3 bit MUX selects which will select one of the 8 CELL outputs for gating control</description>
              <msb>7</msb>
              <lsb>5</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>L3SEL</name>
              <description>CLB L3SEL[1:0] bit: controls third level Mux select</description>
              <msb>4</msb>
              <lsb>3</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>L2SEL</name>
              <description>CLB L2SEL[1:0] bit: controls second level Mux select</description>
              <msb>2</msb>
              <lsb>1</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>L1SEL</name>
              <description>CLB L1SEL bit: first level MUX select value</description>
              <msb>0</msb>
              <lsb>0</lsb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MISCACCESSCTRL</name>
          <description>CLB misc access control register</description>
          <addressOffset>0x00000098</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>BLKEN</name>
              <description>CLB BLKEN bit: this bit is used to block writes to CLBOUTEN</description>
              <msb>1</msb>
              <lsb>1</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>RXFIFOEN</name>
              <description>CLB RXFIFOEN bit: this bit indicates the status of the data FIFO ability to export CLB output data</description>
              <msb>0</msb>
              <lsb>0</lsb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPIDATACTRLHI</name>
          <description>CLB spi data control high part register</description>
          <addressOffset>0x0000009C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CTRDSEL</name>
              <description>CLB CTRDSEL[1:0] bit: when STRBEN=1 data selected to load</description>
              <msb>12</msb>
              <lsb>11</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>SHIFT</name>
              <description>CLB SHIFT[2:0] bit: this is a 3 bit value which be load to FIFO</description>
              <msb>10</msb>
              <lsb>8</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>STRBEN</name>
              <description>CLB STRBEN bit: whether to enable the selceted pulse event</description>
              <msb>7</msb>
              <lsb>7</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>STRB</name>
              <description>CLB STRB[4:0] bit: this is a 5 bit value which selects one of the HLCEVENT inputs to be treated as the data valid strobe</description>
              <msb>4</msb>
              <lsb>0</lsb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SRCTRL</name>
          <description>CLB state control register</description>
          <addressOffset>0x000000A0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>IF3NMIEN</name>
              <description>CLB IF3NMIEN bit: active when NEWCFG.nmiopt=1 3</description>
              <msb>19</msb>
              <lsb>19</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>IF2NMIEN</name>
              <description>CLB IF2NMIEN bit: active when NEWCFG.nmiopt=1 2</description>
              <msb>18</msb>
              <lsb>18</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>IF1NMIEN</name>
              <description>CLB IF1NMIEN bit: active when NEWCFG.nmiopt=1 1</description>
              <msb>17</msb>
              <lsb>17</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>IF0NMIEN</name>
              <description>CLB IF0NMIEN bit: active when NEWCFG.nmiopt=1 0</description>
              <msb>16</msb>
              <lsb>16</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>LEVEL</name>
              <description>CLB LEVEL[4:0] bit: level selection bit</description>
              <msb>12</msb>
              <lsb>8</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>IFLAG3IE</name>
              <description>CLB IFLAG3IE bit: interrupt flag 3 enable bit</description>
              <msb>7</msb>
              <lsb>7</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>IFLAG2IE</name>
              <description>CLB IFLAG2IE bit: interrupt flag 2 enable bit</description>
              <msb>6</msb>
              <lsb>6</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>IFLAG1IE</name>
              <description>CLB IFLAG1IE bit: interrupt flag 1 enable bit</description>
              <msb>5</msb>
              <lsb>5</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>IFLAG0IE</name>
              <description>CLB IFLAG0IE bit: interrupt flag 0 enable bit</description>
              <msb>4</msb>
              <lsb>4</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>DMAEN</name>
              <description>CLB DMAEN bit: DMA enable</description>
              <msb>2</msb>
              <lsb>2</lsb>
              <access>read-only</access>
            </field>
            <field>
              <name>FULLIE</name>
              <description>CLB FULLIE bit: full interrupt enable</description>
              <msb>1</msb>
              <lsb>1</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>DRDYIE</name>
              <description>CLB DRDYIE bit: data ready interrupt enable </description>
              <msb>0</msb>
              <lsb>0</lsb>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SR</name>
          <description>CLB state register</description>
          <addressOffset>0x000000A4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>STATE</name>
              <description>CLB STATE[1:0] bit: FIFO state enable bit</description>
              <msb>17</msb>
              <lsb>16</lsb>
              <access>read-only</access>
            </field>
            <field>
              <name>FIFOST</name>
              <description>CLB FIFOST[4:0] bit: data number in FIFO</description>
              <msb>12</msb>
              <lsb>8</lsb>
              <access>read-only</access>
            </field>
            <field>
              <name>IFLAG3</name>
              <description>CLB IFLAG3 bit: interrupt flag for event 3</description>
              <msb>7</msb>
              <lsb>7</lsb>
              <access>read-only</access>
            </field>
            <field>
              <name>IFLAG2</name>
              <description>CLB IFLAG2 bit: interrupt flag for event 2</description>
              <msb>6</msb>
              <lsb>6</lsb>
              <access>read-only</access>
            </field>
            <field>
              <name>IFLAG1</name>
              <description>CLB IFLAG1 bit: interrupt flag for event 1</description>
              <msb>5</msb>
              <lsb>5</lsb>
              <access>read-only</access>
            </field>
            <field>
              <name>IFLAG0</name>
              <description>CLB IFLAG0 bit: interrupt flag for event 0</description>
