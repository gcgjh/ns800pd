              <msb>24</msb>
              <lsb>24</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNT2MATCH2TAPEN</name>
              <description>CLB COUNT2MATCH2TAPEN bit: if the match2 output should come from the match unit or tapped from a bit position of the counter 2</description>
              <msb>23</msb>
              <lsb>23</lsb>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNT1MATCH2TAPEN</name>
