    <peripheral>
      <name>I2C1</name>
      <description> Inter-Integrated Circuit 1</description>
      <baseAddress>0x40048000</baseAddress>
      <interrupt>
        <name>I2C1_MST</name>
        <description>I2C1 Master interrupt</description>
        <value>183</value>
      </interrupt>
      <interrupt>
        <name>I2C1_SLV</name>
        <description>I2C1 Slaver  interrupt</description>
        <value>184</value>
      </interrupt>
      <groupName>I2C</groupName>
      <headerStructName>I2C</headerStructName>
      <size>32</size>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x174</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>MCR</name>
          <description>I2C master control register </description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>RRF</name>
              <description>I2C RRF bit: reset receive FIFO</description>
              <msb>9</msb>
              <lsb>9</lsb>
              <access>write-only</access>
            </field>
            <field>
              <name>RTF</name>
              <description>I2C RTF bit: reset transmit FIFO</description>
              <msb>8</msb>
              <lsb>8</lsb>
              <access>write-only</access>
            </field>
            <field>
