        <name>EPWM1_TZINT</name>
        <description>EPWM1 trip zone(fault protect) interrupt</description>
        <value>90</value>
      </interrupt>
      <interrupt>
        <name>EPWM1_INT</name>
        <description>EPWM1 event interrupt</description>
        <value>108</value>
      </interrupt>
      <groupName>EPWM</groupName>
      <headerStructName>EPWM</headerStructName>
      <size>32</size>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x7CC</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>TBCTL</name>
